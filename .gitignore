.DS_Store
Thumbs.db
*.log
*~
*.bak
*.orig
*.swp
*.swo

tools/dist/
tools/shots/
tools/modules/*.js

# Agent scratch. The review and module workflows write throwaway probe scripts and screenshots
# next to the harness; anything prefixed with an underscore is scratch and never ships.
tools/_*

# Local installs of the optional browser harness and its reports.
node_modules/
playwright-report/
test-results/
blob-report/

# Optional native experiment environment and uncommitted run outputs.
.venv-heavy/
heavy-output/
__pycache__/

# Offline validator logs, checkpoints, native builds and result bundles.
apps/validate/.runs/

# Volunteer results remain local until explicitly selected for publication.
run/validator/logs/
run/validator/screenshots/
run/validator/misses/
validation/results/witnesses-*.json

# Never commit copyrighted publisher PDFs or full-text paper extracts under lit sources
identities/sources/**/*.pdf
identities/sources/**/*.txt

# LaTeX build output of the paper, if it is built in place under research/.
research/*.aux
research/*.out
research/*.pdf
