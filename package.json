{
  "name": "genchase-development",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "build:check": "node tools/build.js --check",
    "index": "node tools/index.js",
    "lint": "node tools/lint.js",
    "science": "node tools/science.js",
    "test": "node tools/maintenance-check.js && node tools/verify-check.js && node tools/folder-check.js && node tools/verify.js --list --all",
    "test:solvers": "node tools/verify.js --all",
    "test:print": "node tools/verify.js --print --all",
    "test:all": "npm test && npm run build:check && npm run lint && npm run science && node tools/verify.js --print --all",
    "test:engine": "node tools/engine-api-check.js && node tools/folder-browser.js",
    "test:ui": "node tools/ui.js && node tools/colophon-check.js && node tools/reports-check.js && node tools/art-only-check.js",
    "test:formats": "node tools/print-formats-check.js",
    "test:smoothing": "node tools/print-smoothing-check.js && node tools/print-smoothing-browser.js",
    "prepress:help": "python3 tools/prepress.py --help",
    "validator": "node apps/validate/server.js",
    "test:validator": "node --test apps/validate/*.test.js",
    "validator:headless": "node apps/validate/cli.js",
    "test:navigation": "node tools/studio-navigation-check.js",
    "test:validator:ui": "node tools/validator-ui-check.js && node tools/validator-ux-check.js",
    "setup:checks": "node tools/setup-checks.js"
  }
}
